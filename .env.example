# Optional. Public site origin used by the sitemap and metadata.
# Set this in the Vercel project after the first deploy, then redeploy.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Shared site password. One password for everyone; there are no accounts.
SITE_PASSWORD=

# Signs the login cookie. Use a long random string. Never commit a real value.
SESSION_SECRET=
